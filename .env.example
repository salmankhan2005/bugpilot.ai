# Enable the local-only Playwright run path (development mode only).
LOCAL_WORKER_ENABLED=false

# Neon Postgres connection string. Use the pooled URL with sslmode=require.
NEON_DATABASE_URL=
# Legacy fallback name; use NEON_DATABASE_URL for new setups.
DATABASE_URL=
# Optional direct, non-pooler URL for schema migrations only.
NEON_DATABASE_URL_UNPOOLED=
# Legacy fallback name for the direct migration URL.
DATABASE_URL_UNPOOLED=

# Cloud Redis connection string supported by BullMQ.
REDIS_URL=

# Comma-separated exact origins the local browser may visit.
# For a local site, examples: http://localhost:3001,http://127.0.0.1:3001
LOCAL_WORKER_ALLOWED_ORIGINS=

# Set to true to open a visible browser window instead of headless Chromium.
LOCAL_WORKER_HEADED=false

# Optional server-side Groq diagnosis. The local worker sends only redacted,
# bounded finding evidence after the user requests a diagnosis.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=20000
LLM_MAX_TOKENS=1200

# Firebase Authentication web app settings (from Firebase Console > Project settings).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only Firebase Admin configuration. Keep the service-account file outside the repo.
FIREBASE_PROJECT_ID=bupilotai
GOOGLE_APPLICATION_CREDENTIALS=
